# Server only. Never expose to the web, desktop or mobile shells.
AGNES_API_KEY=
# Optional Token Plan key; preferred over AGNES_API_KEY when set.
TOKEN_PLAN_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_ORIGIN=https://apihub.agnes-ai.com
# Requests per minute. Defaults are the free tier (text 10, image 10, video 1).
TEXT_RPM=
IMAGE_RPM=
VIDEO_RPM=
# Leave blank for apps/api/data/campaign.db and apps/api/data/assets
DATABASE_PATH=
ASSETS_DIR=
# Public address for tracked links, reachable from a phone for real click tracking.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Encrypts keys saved in Settings.
KEY_ENCRYPTION_MASTER=
# Optional: real cold email. Without these the app opens the mail app instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
