# Server only. Never expose to the web, desktop or mobile shells.
AGNES_API_KEY=
# Optional Token Plan key; preferred over AGNES_API_KEY when set.
TOKEN_PLAN_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_ORIGIN=https://apihub.agnes-ai.com
# Requests per minute. Defaults are the free tier (text 10, image 10, video 1).
TEXT_RPM=
IMAGE_RPM=
VIDEO_RPM=
# Leave blank for apps/api/data/campaign.db and apps/api/data/assets
DATABASE_PATH=
ASSETS_DIR=
# Public address for tracked links, reachable from a phone for real click tracking.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Encrypts keys saved in Settings.
KEY_ENCRYPTION_MASTER=
# Optional: real cold email. Without these the app opens the mail app instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional speech and extra model keys (not wired yet)
GROQ_API_KEY=
GEMINI_API_KEY=

# Sign in with Google (see docs/merge.md). Register http://127.0.0.1:8000/auth/google/callback and http://localhost:8000/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated Google accounts allowed in; empty means any Google account.
ALLOWED_EMAILS=
# 1 = the API refuses everything except /health, /auth and tracked links until someone signs in.
REQUIRE_LOGIN=
# Where the browser returns after login; blank uses http://<same host>:5173.
FRONTEND_URL=
# Signs the session cookie; blank creates apps/api/data/session.key.
SESSION_SECRET=
# Extra allowed browser origins, comma separated (local, desktop and phone shells are already allowed).
CORS_ORIGINS=

# Instagram login (Meta developer app, "Instagram API with Instagram Login"). Business or Creator accounts; testers only until app review.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/auth/instagram/callback

# YouTube Shorts upload reuses the Google client above. Enable "YouTube Data API v3", add the youtube.upload and youtube.readonly
# scopes on the consent screen, and add this redirect URI to the Google client.
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/auth/youtube/callback

# Scheduled emails run in the API process. Set to "off" to stop the background loop.
SCHEDULER=on

# ElevenLabs: GrowIt's voice (text to speech), speech to text (Scribe), and the live briefing agent on the Memory screen.
AGNEZ_ELEVENLABS_API_KEY=
AGNEZ_AGENT_ID=
# Optional: a different premade voice (default is Sarah) or model.
ELEVENLABS_VOICE_ID=
# Talk chat replies come from Groq first (fastest), then Gemini, then Agnes. Each of Groq and Gemini has a switch in Settings.
# GROQ_API_KEY=
# GEMINI_API_KEY=
